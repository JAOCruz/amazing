<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- account.move form view: add e-CF buttons, status badge, XML download -->
    <!-- ================================================================== -->
    <record id="view_move_form_ecf" model="ir.ui.view">
        <field name="name">account.move.form.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">

            <!-- e-CF status badge in the header -->
            <xpath expr="//header" position="inside">
                <field name="l10n_do_ecf_status" widget="badge"
                       decoration-info="l10n_do_ecf_status == 'generated'"
                       decoration-warning="l10n_do_ecf_status == 'sent'"
                       decoration-success="l10n_do_ecf_status == 'accepted'"
                       decoration-danger="l10n_do_ecf_status in ('rejected', 'error')"
                       invisible="not is_ecf_invoice"/>
            </xpath>

            <!-- B01/B02 type and DGII toggle below the title -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')" col="2">
                    <field name="l10n_do_b_code" readonly="1"/>
                    <field name="l10n_do_send_to_dgii"/>
                </group>
            </xpath>

            <!-- e-CF action buttons in the header -->
            <xpath expr="//header" position="inside">
                <button name="action_generate_ecf_xml"
                        string="Generate e-CF XML"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_ecf_invoice or state != 'posted' or l10n_do_ecf_status not in ('draft', 'error', 'rejected')"
                        groups="account.group_account_invoice"/>
                <button name="action_send_ecf_to_dgii"
                        string="Send to DGII"
                        type="object"
                        class="btn-primary"
                        invisible="not is_ecf_invoice or state != 'posted' or l10n_do_ecf_status not in ('generated', 'error', 'rejected')"
                        groups="account.group_account_invoice"/>
                <button name="action_check_ecf_status"
                        string="Check Status"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_ecf_invoice or l10n_do_ecf_status != 'sent'"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- e-CF tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="e-CF" name="ecf_tab"
                      invisible="not l10n_latam_document_type_id">
                    <group>
                        <group string="Configuración e-CF">
                            <field name="l10n_do_send_to_dgii" invisible="state != 'draft'"/>
                            <field name="is_ecf_invoice" readonly="1"/>
                        </group>
                        <group string="e-CF Document" invisible="not is_ecf_invoice">
                            <field name="l10n_do_ecf_status" readonly="1"/>
                            <field name="l10n_do_ecf_track_id" readonly="1"/>
                            <field name="l10n_do_ecf_security_code" readonly="1"/>
                            <field name="l10n_do_ecf_sign_date" readonly="1"/>
                            <field name="l10n_do_ecf_edi_file" filename="l10n_do_ecf_edi_file_name" readonly="1"/>
                            <field name="l10n_do_ecf_edi_file_name" invisible="1"/>
                        </group>
                        <group string="DGII Response">
                            <field name="l10n_do_ecf_dgii_message" readonly="1"/>
                            <field name="l10n_do_electronic_stamp" widget="url" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ================================================================== -->
    <!-- account.move list view: add e-CF status column -->
    <!-- ================================================================== -->
    <record id="view_move_list_ecf" model="ir.ui.view">
        <field name="name">account.move.list.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="l10n_do_send_to_dgii" optional="hide"/>
                <field name="is_ecf_invoice" optional="hide"/>
                <field name="l10n_do_ecf_status" optional="hide"
                       widget="badge"
                       decoration-info="l10n_do_ecf_status == 'generated'"
                       decoration-warning="l10n_do_ecf_status == 'sent'"
                       decoration-success="l10n_do_ecf_status == 'accepted'"
                       decoration-danger="l10n_do_ecf_status in ('rejected', 'error')"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- account.move search view: e-CF filters and grouping                 -->
    <!-- ================================================================== -->
    <record id="view_account_invoice_filter_ecf" model="ir.ui.view">
        <field name="name">account.invoice.filter.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="l10n_do_b_code" string="Tipo (B01/B02)"/>
                <field name="l10n_do_ecf_status" string="Estado e-CF"/>

                <separator/>
                <filter string="Enviar a DGII" name="ecf_send_to_dgii"
                        domain="[('l10n_do_send_to_dgii', '=', True)]"/>
                <filter string="Sin DGII" name="ecf_no_dgii"
                        domain="[('l10n_do_send_to_dgii', '=', False)]"/>

                <separator/>
                <filter string="e-CF" name="ecf_is_ecf"
                        domain="[('is_ecf_invoice', '=', True)]"/>
                <filter string="No e-CF" name="ecf_not_ecf"
                        domain="[('is_ecf_invoice', '=', False)]"/>

                <separator/>
                <filter string="B01 (Crédito Fiscal)" name="ecf_b01"
                        domain="[('l10n_do_b_code', '=', 'B01')]"/>
                <filter string="B02 (Consumo)" name="ecf_b02"
                        domain="[('l10n_do_b_code', '=', 'B02')]"/>

                <separator/>
                <filter string="e-CF: Borrador" name="ecf_status_draft"
                        domain="[('l10n_do_ecf_status', '=', 'draft')]"/>
                <filter string="e-CF: XML Generado" name="ecf_status_generated"
                        domain="[('l10n_do_ecf_status', '=', 'generated')]"/>
                <filter string="e-CF: Enviado" name="ecf_status_sent"
                        domain="[('l10n_do_ecf_status', '=', 'sent')]"/>
                <filter string="e-CF: Aceptado" name="ecf_status_accepted"
                        domain="[('l10n_do_ecf_status', '=', 'accepted')]"/>
                <filter string="e-CF: Rechazado" name="ecf_status_rejected"
                        domain="[('l10n_do_ecf_status', '=', 'rejected')]"/>
                <filter string="e-CF: Error" name="ecf_status_error"
                        domain="[('l10n_do_ecf_status', '=', 'error')]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Tipo e-CF" name="group_by_b_code"
                            context="{'group_by': 'l10n_do_b_code'}"/>
                    <filter string="Estado e-CF" name="group_by_ecf_status"
                            context="{'group_by': 'l10n_do_ecf_status'}"/>
                    <filter string="Enviar a DGII" name="group_by_send_dgii"
                            context="{'group_by': 'l10n_do_send_to_dgii'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
