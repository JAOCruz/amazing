<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- REPORT ACTION                                 -->
        <!-- ============================================ -->

        <record id="action_report_manufacturing_bill" model="ir.actions.report">
            <field name="name">🧾 Factura de Manufactura (Estilo Amazing)</field>
            <field name="model">manufacturing.bill</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_manufacturing_dashboard.report_manufacturing_bill</field>
            <field name="report_file">custom_manufacturing_dashboard.report_manufacturing_bill</field>
            <field name="print_report_name">'Factura_%s' % object.name</field>
            <field name="binding_model_id" ref="model_manufacturing_bill"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ============================================ -->
        <!-- REPORT DOCUMENT TEMPLATE                      -->
        <!-- ============================================ -->

        <template id="report_manufacturing_bill_document">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang or doc.env.user.lang)"/>

                <div class="page" style="font-family: 'Work Sans', Helvetica, Arial, sans-serif; color: #1f2937;">

                    <style>
                        /* ===== Brand Colors ===== */
                        .text-brand { color: #2e4159; }
                        .bg-brand { background-color: #2e4159; color: white; }
                        .text-gold { color: #f4a259; }
                        .bg-gold { background-color: #f4a259; color: white; }

                        /* ===== Cards ===== */
                        .bill-card {
                            background: white;
                            border-radius: 8px;
                            border: 1px solid #9ca3af;
                            overflow: hidden;
                            margin-bottom: 20px;
                        }
                        .bill-card-header {
                            background-color: #2e4159;
                            color: white;
                            padding: 10px 15px;
                            font-weight: 700;
                            font-size: 13px;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                            border-bottom: 1px solid #1f2937;
                        }
                        .bill-card-body {
                            padding: 15px;
                        }

                        /* ===== Info Tables (inside cards) ===== */
                        .bill-info-table td {
                            padding: 5px 0;
                            vertical-align: middle;
                        }
                        .bill-info-label {
                            color: #6b7280;
                            font-weight: 500;
                            font-size: 12px;
                            width: 35%;
                            text-transform: uppercase;
                            letter-spacing: 0.3px;
                        }
                        .bill-info-value {
                            color: #111827;
                            font-weight: 600;
                            font-size: 14px;
                        }

                        /* ===== Line Items Table ===== */
                        .bill-lines-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .bill-lines-table th {
                            background-color: #2e4159;
                            color: white;
                            border: 1px solid #1f2937;
                            padding: 10px 12px;
                            font-size: 11px;
                            text-transform: uppercase;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                        }
                        .bill-lines-table td {
                            border: 1px solid #d1d5db;
                            padding: 10px 12px;
                            color: #374151;
                            font-size: 13px;
                            vertical-align: middle;
                        }
                        .bill-lines-table tbody tr:nth-child(even) {
                            background-color: #f9fafb;
                        }

                        /* ===== Totals ===== */
                        .totals-table {
                            border-collapse: collapse;
                        }
                        .totals-table td {
                            padding: 8px 14px;
                            font-size: 14px;
                        }
                        .totals-table .total-row td {
                            font-weight: 800;
                            font-size: 20px;
                            color: #2e4159;
                            border-top: 3px solid #2e4159;
                            padding-top: 12px;
                        }

                        /* ===== Badges ===== */
                        .badge-pill-custom {
                            padding: 4px 14px;
                            border-radius: 4px;
                            font-size: 11px;
                            font-weight: bold;
                            display: inline-block;
                            border: 1px solid transparent;
                            letter-spacing: 0.3px;
                        }
                        .badge-draft { background-color: #eff6ff; color: #1e40af; border-color: #bfdbfe; }
                        .badge-confirmed { background-color: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
                        .badge-invoiced { background-color: #f5f3ff; color: #5b21b6; border-color: #c4b5fd; }
                        .badge-cancelled { background-color: #fef2f2; color: #991b1b; border-color: #fecaca; }
                        .badge-fiscal { background-color: #fffbeb; color: #92400e; border-color: #fcd34d; }
                        .badge-no-fiscal { background-color: #f3f4f6; color: #6b7280; border-color: #d1d5db; }

                        /* ===== Title ===== */
                        h2.bill-title {
                            color: #2e4159;
                            font-weight: 800;
                            font-size: 28px;
                            margin: 0;
                            line-height: 1.2;
                        }
                        .bill-subtitle {
                            color: #4b5563;
                            font-size: 13px;
                            margin-top: 4px;
                        }

                        /* ===== Watermark for draft ===== */
                        .watermark-draft {
                            position: absolute;
                            top: 40%;
                            left: 15%;
                            font-size: 80px;
                            font-weight: 900;
                            color: rgba(220, 38, 38, 0.06);
                            transform: rotate(-30deg);
                            pointer-events: none;
                            z-index: 0;
                            letter-spacing: 10px;
                        }
                    </style>

                    <!-- Draft watermark -->
                    <div t-if="doc.state == 'draft'" class="watermark-draft">BORRADOR</div>

                    <!-- ============================================ -->
                    <!-- HEADER                                        -->
                    <!-- ============================================ -->

                    <div class="row mb-4 pb-3" style="border-bottom: 3px solid #f4a259;">
                        <div class="col-8">
                            <h2 class="bill-title">
                                FACTURA <span t-field="doc.name"/>
                            </h2>
                            <div class="mt-2">
                                <!-- State badge -->
                                <span t-if="doc.state == 'draft'" class="badge-pill-custom badge-draft">BORRADOR</span>
                                <span t-if="doc.state == 'confirmed'" class="badge-pill-custom badge-confirmed">CONFIRMADA</span>
                                <span t-if="doc.state == 'invoiced'" class="badge-pill-custom badge-invoiced">FACTURADA</span>
                                <span t-if="doc.state == 'cancelled'" class="badge-pill-custom badge-cancelled">CANCELADA</span>
                                <!-- Fiscal badge -->
                                <span t-if="doc.fiscal_receipt == 'with'" class="badge-pill-custom badge-fiscal ml-1">CON COMPROBANTE FISCAL</span>
                                <span t-if="doc.fiscal_receipt == 'without'" class="badge-pill-custom badge-no-fiscal ml-1">SIN COMPROBANTE</span>
                            </div>
                            <div class="bill-subtitle mt-2">
                                <strong>Fecha:</strong> <span t-field="doc.date_bill"/>
                                <span class="mx-2">|</span>
                                <strong>Orden:</strong> <span t-field="doc.production_id"/>
                                <t t-if="doc.invoice_id">
                                    <span class="mx-2">|</span>
                                    <strong>Factura Odoo:</strong> <span t-field="doc.invoice_id"/>
                                </t>
                            </div>
                        </div>
                        <div class="col-4 text-right">
                            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', doc.name, 600, 100)" style="width:100%; height:60px;"/>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- CLIENT + CASE INFO CARDS                      -->
                    <!-- ============================================ -->

                    <div class="row">
                        <!-- Client Card -->
                        <div class="col-6">
                            <div class="bill-card">
                                <div class="bill-card-header">
                                    Facturar a
                                </div>
                                <div class="bill-card-body">
                                    <table class="bill-info-table" style="width:100%">
                                        <tr>
                                            <td class="bill-info-label">Cliente:</td>
                                            <td class="bill-info-value"><span t-field="doc.partner_id"/></td>
                                        </tr>
                                        <tr t-if="doc.partner_id.vat">
                                            <td class="bill-info-label">RNC / Cédula:</td>
                                            <td class="bill-info-value" style="font-weight:400;"><span t-field="doc.partner_id.vat"/></td>
                                        </tr>
                                        <tr t-if="doc.partner_id.street">
                                            <td class="bill-info-label">Dirección:</td>
                                            <td class="bill-info-value" style="font-weight:400;">
                                                <span t-field="doc.partner_id.street"/>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.partner_id.phone or doc.partner_id.mobile">
                                            <td class="bill-info-label">Teléfono:</td>
                                            <td class="bill-info-value" style="font-weight:400;">
                                                <t t-if="doc.partner_id.phone"><span t-field="doc.partner_id.phone"/></t>
                                                <t t-if="doc.partner_id.mobile and not doc.partner_id.phone"><span t-field="doc.partner_id.mobile"/></t>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.partner_id.email">
                                            <td class="bill-info-label">Email:</td>
                                            <td class="bill-info-value" style="font-weight:400; font-size: 12px;">
                                                <span t-field="doc.partner_id.email"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Case Info Card -->
                        <div class="col-6">
                            <div class="bill-card" style="border-color: #f4a259;">
                                <div class="bill-card-header" style="background-color: #f4a259;">
                                    Datos del Caso
                                </div>
                                <div class="bill-card-body">
                                    <table class="bill-info-table" style="width:100%">
                                        <tr t-if="doc.patient_name">
                                            <td class="bill-info-label">Paciente:</td>
                                            <td class="bill-info-value"><span t-field="doc.patient_name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="bill-info-label">Orden:</td>
                                            <td class="bill-info-value"><span t-field="doc.production_id"/></td>
                                        </tr>
                                        <tr t-if="doc.production_id.product_id">
                                            <td class="bill-info-label">Producto:</td>
                                            <td class="bill-info-value" style="font-weight:400;">
                                                <span t-esc="doc.production_id.product_id.name"/>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.production_id.teeth_count">
                                            <td class="bill-info-label">Dientes:</td>
                                            <td class="bill-info-value" style="font-weight:400;">
                                                <span t-esc="doc.production_id.teeth_count"/> piezas
                                            </td>
                                        </tr>
                                        <tr t-if="doc.fiscal_position_id">
                                            <td class="bill-info-label">Pos. Fiscal:</td>
                                            <td class="bill-info-value" style="font-weight:400; font-size: 12px;">
                                                <span t-field="doc.fiscal_position_id"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- LINE ITEMS TABLE                               -->
                    <!-- ============================================ -->

                    <div class="mt-2 mb-4">
                        <h4 class="text-brand mb-3" style="font-weight: 700; border-bottom: 2px solid #e5e7eb; padding-bottom: 5px;">
                            Detalle de Servicios
                        </h4>

                        <table class="bill-lines-table">
                            <thead>
                                <tr>
                                    <th width="5%" class="text-center">#</th>
                                    <th width="50%">Descripción</th>
                                    <th width="12%" class="text-center">Cantidad</th>
                                    <th width="16%" class="text-right">Precio Unit.</th>
                                    <th width="17%" class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_num" t-value="0"/>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <t t-set="line_num" t-value="line_num + 1"/>
                                    <td class="text-center" style="color: #9ca3af; font-weight: 600;"><t t-esc="line_num"/></td>
                                    <td style="font-weight: 500;"><span t-field="line.name"/></td>
                                    <td class="text-center"><span t-field="line.quantity"/></td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-right" style="font-weight: 600;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- ============================================ -->
                    <!-- NOTES + TOTALS                                -->
                    <!-- ============================================ -->

                    <div class="row">
                        <!-- Notes (left side) -->
                        <div class="col-7">
                            <div t-if="doc.notes" class="bill-card" style="border-color: #f4a259; background-color: #fffaf0;">
                                <div class="bill-card-body">
                                    <strong class="text-gold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Notas:</strong><br/>
                                    <span style="font-style: italic; color: #374151; font-size: 13px; line-height: 1.6;" t-field="doc.notes"/>
                                </div>
                            </div>
                        </div>

                        <!-- Totals (right side) -->
                        <div class="col-5">
                            <table class="totals-table" style="width:100%; text-align:right;">
                                <tr>
                                    <td style="color:#6b7280; font-size: 13px; text-transform: uppercase;">Subtotal:</td>
                                    <td style="font-weight:600;">
                                        <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="doc.amount_discount > 0">
                                    <td style="color:#6b7280; font-size: 13px; text-transform: uppercase;">Descuento:</td>
                                    <td style="font-weight:600; color:#dc2626;">
                                        -<span t-field="doc.amount_discount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="total-row">
                                    <td>TOTAL:</td>
                                    <td>
                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- FISCAL INFO FOOTER                             -->
                    <!-- ============================================ -->

                    <div t-if="doc.fiscal_receipt == 'with' and doc.fiscal_position_id" class="mt-3" style="border-top: 1px dashed #d1d5db; padding-top: 10px;">
                        <table style="width: 100%; font-size: 11px; color: #6b7280;">
                            <tr>
                                <td style="width: 50%;">
                                    <strong style="color: #374151;">Posición Fiscal:</strong> <span t-field="doc.fiscal_position_id"/>
                                </td>
                                <td style="width: 50%; text-align: right;">
                                    <strong style="color: #374151;">Moneda:</strong> <span t-field="doc.currency_id"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ============================================ -->
                    <!-- SIGNATURE LINES                                -->
                    <!-- ============================================ -->

                    <div class="row" style="margin-top: 60px; page-break-inside: avoid;">
                        <div class="col-6 text-center">
                            <div style="border-top: 1px solid #1f2937; width: 80%; margin: 0 auto 10px auto;"></div>
                            <p class="font-weight-bold text-brand" style="font-size: 12px; letter-spacing: 1px;">LABORATORIO</p>
                        </div>
                        <div class="col-6 text-center">
                            <div style="border-top: 1px solid #1f2937; width: 80%; margin: 0 auto 10px auto;"></div>
                            <p class="font-weight-bold text-brand" style="font-size: 12px; letter-spacing: 1px;">CLIENTE</p>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- SMALL PRINT FOOTER                             -->
                    <!-- ============================================ -->

                    <div class="text-center mt-4" style="font-size: 10px; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 8px;">
                        Documento generado el <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        <span class="mx-1">|</span>
                        <span t-field="doc.company_id.name"/>
                    </div>

                </div>
            </t>
        </template>

        <!-- ============================================ -->
        <!-- REPORT CONTAINER                              -->
        <!-- ============================================ -->

        <template id="report_manufacturing_bill">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="custom_manufacturing_dashboard.report_manufacturing_bill_document"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
