<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_mrp_production_form_inherit_dashboard" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.dashboard</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='priority']" position="after">
                    <field name="is_vip" widget="boolean_toggle" string="⭐ VIP"/>
                </xpath>

                <xpath expr="//page[@name='components']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Información del Paciente" name="patient_info">
                        <group>
                            <group string="Datos del Paciente">
                                <field name="patient_name"/>
                                <field name="doctor_id" context="{'default_is_company': False}"/>
                                <field name="clinic_id" context="{'default_is_company': True}"/>
                            </group>
                            <group string="Especificaciones del Producto">
                                <field name="product_type"/>
                                <field name="work_type"/>
                                <field name="teeth_numbers" widget="text"/>
                                <field name="teeth_count"/>
                            </group>
                        </group>
                        <group>
                            <div colspan="2" style="padding:4px 0 12px;">
                                <div style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;">🦷 Diagrama de Dientes</div>
                                <!-- teeth_display: read-only diagram (always visible) -->
                                <field name="teeth_numbers" nolabel="1" readonly="1" widget="teeth_display"/>
                                <!-- Edit button — managers only, bound to tooth_shades to avoid duplicate teeth_numbers declaration -->
                                <div style="margin-top:10px;" invisible="state == 'cancel'"
                                     groups="custom_manufacturing_dashboard.group_manufacturing_manager">
                                    <field name="tooth_shades" widget="teeth_selector_edit" nolabel="1"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <group string="Color y Material">
                                <field name="color_scale"/>
                                <field name="color_selected"/>
                                <field name="material"/>
                                <field name="translucency"/>
                                <!-- tooth_shades is now rendered inside the teeth_selector above -->
                            </group>
                            <group string="Timeline y Estado">
                                <field name="deadline_days"/>
                                <field name="manufacturing_start_date"/>
                                <field name="manufacturing_time" widget="float_time"/>
                                <field name="stage_custom"/>
                            </group>
                        </group>
                        <group string="Alertas y Prioridad">
                            <field name="is_delayed" readonly="1"/>
                            <field name="is_urgent" readonly="1"/>
                            <field name="is_pending" readonly="1"/>
                            <field name="is_vip"/>
                        </group>
                        <group string="💰 Recargo Extra" invisible="extra_percentage == 0">
                            <field name="extra_percentage" widget="percentage" string="% de Recargo"/>
                            <field name="extra_percentage_reason" string="Motivo"/>
                        </group>
                    </page>
                    <page string="Materiales Recibidos" name="materials_checklist">
                        <group>
                            <group string="Componentes (Cantidades)">
                                <field name="qty_tibase"/>
                                <field name="qty_analogo"/>
                                <field name="qty_tornillo"/>
                                <field name="qty_transfer"/>
                                <field name="qty_calcinable"/>
                                <field name="qty_mini_pilares"/>
                            </group>
                            <group string="Modelos y Encerados">
                                <field name="qty_antagonistas"/>
                                <field name="qty_encerado_superior"/>
                                <field name="qty_encerado_inferior"/>
                                <field name="qty_modelo_superior"/>
                                <field name="qty_modelo_inferior"/>
                                <field name="qty_mordida_superior"/>
                                <field name="qty_mordida_inferior"/>
                            </group>
                        </group>
                        <group string="📝 Comentarios del Doctor" colspan="2">
                            <field name="doctor_comments" nolabel="1" widget="text"/>
                        </group>
                        <group string="📷 Fotos del Caso" colspan="2">
                            <field name="photo_ids" nolabel="1" widget="many2many_binary"/>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//header" position="inside">
                    <div class="alert alert-danger" invisible="time_priority != 4" role="alert">
                        <strong>⚠️ ORDEN RETRASADA</strong> - Tiempo transcurrido excede el deadline
                    </div>
                    <div class="alert alert-warning" invisible="time_priority != 3" role="alert">
                        <strong>⏰ ORDEN URGENTE</strong> - Tiempo transcurrido cerca del deadline (80%)
                    </div>
                    <div class="alert alert-info" invisible="not is_vip" role="alert">
                        <strong>⭐ CLIENTE VIP</strong> - Prioridad alta
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_mrp_workorder_custom_list_fix" model="ir.ui.view">
            <field name="name">mrp.workorder.custom.list.fix</field>
            <field name="model">mrp.workorder</field> 
            <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='duration']" position="before">
                    <field name="date_start" column_invisible="1"/>
                    <field name="state" column_invisible="1"/>
                    <field name="is_user_working" column_invisible="1"/>
                    <field name="working_state" column_invisible="1"/> 
                </xpath>

                <xpath expr="//field[@name='duration']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                    <attribute name="string">T. Real</attribute>
                    
                    <attribute name="widget">mrp_timer</attribute> 
                    
                    <attribute name="sum">Total Real</attribute>
                </xpath>

                <xpath expr="//field[@name='duration_expected']" position="replace">
                    <field name="alert_time_hours" 
                           string="T. Estimado" 
                           widget="float_time" 
                           sum="Total Est."/>
                </xpath>

                <xpath expr="//field[@name='qty_remaining']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='button_finish']" position="attributes">
                    <attribute name="confirm">¿Estás seguro de que deseas cerrar esta orden de trabajo?</attribute>
                </xpath>

            </field>
        </record>

