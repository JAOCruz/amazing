<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================ -->
        <!-- GRUPOS DE SEGURIDAD -->
        <!-- ============================================ -->

        <!-- Categoría del módulo (internal users) -->
        <record id="module_category_manufacturing_dashboard" model="ir.module.category">
            <field name="name">Dashboard Manufactura</field>
            <field name="description">Permisos del dashboard de manufactura dental</field>
            <field name="sequence">21</field>
            <field name="visible" eval="True"/>
        </record>

        <!-- Categoría separada para doctores (portal users) -->
        <record id="module_category_dental_portal" model="ir.module.category">
            <field name="name">Portal Dental</field>
            <field name="description">Acceso portal para doctores</field>
            <field name="sequence">22</field>
            <field name="visible" eval="True"/>
        </record>

        <!-- Grupo: Empleado de Manufactura -->
        <record id="group_manufacturing_employee" model="res.groups">
            <field name="name">Empleado</field>
            <field name="category_id" ref="module_category_manufacturing_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Empleados de manufactura: pueden ver su propio dashboard,
                sus operaciones asignadas y actualizar el estado de sus tareas.
            </field>
        </record>

        <!-- Grupo: Gerente de Manufactura -->
        <record id="group_manufacturing_manager" model="res.groups">
            <field name="name">Gerente</field>
            <field name="category_id" ref="module_category_manufacturing_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('group_manufacturing_employee'))]"/>
            <field name="comment">
                Gerentes de manufactura: acceso completo controlado por ACLs personalizadas.
            </field>
        </record>

        <!-- Grupo: Doctor (Portal) — categoría separada para no mezclar con usuarios internos -->
        <record id="group_dental_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="module_category_dental_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">
                Doctores externos: acceso limitado a sus propios casos a través del portal.
            </field>
        </record>

        <!-- ============================================ -->
        <!-- REGLAS DE REGISTRO (RECORD RULES) -->
        <!-- ============================================ -->

        <!-- Regla: Empleados VEN todas las workorders de órdenes asignadas -->
        <record id="mrp_workorder_employee_read_all" model="ir.rule">
            <field name="name">Manufacturing Employee: Read All Workorders from Assigned Produccións</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('production_id.workorder_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Empleados solo ESCRIBEN en sus propias workorders -->
        <record id="mrp_workorder_employee_write_own" model="ir.rule">
            <field name="name">Manufacturing Employee: Write Own Workorders</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_employee'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Managers ven todas las operaciones -->
        <record id="mrp_workorder_manager_rule" model="ir.rule">
            <field name="name">Manufacturing Manager: All Workorders</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla: Empleados ven órdenes relacionadas a sus operaciones -->
        <record id="mrp_production_employee_rule" model="ir.rule">
            <field name="name">Manufacturing Employee: Related Produccións</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[('workorder_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Managers ven todas las órdenes de producción -->
        <record id="mrp_production_manager_rule" model="ir.rule">
            <field name="name">Manufacturing Manager: All Produccións</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================ -->
        <!-- REGLAS: MANUFACTURING BILLS -->
        <!-- ============================================ -->

        <!-- Empleados: pueden leer todas las facturas de manufactura -->
        <record id="manufacturing_bill_employee_rule" model="ir.rule">
            <field name="name">Manufacturing Employee: Read All Bills</field>
            <field name="model_id" ref="model_manufacturing_bill"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers: acceso completo a facturas de manufactura -->
        <record id="manufacturing_bill_manager_rule" model="ir.rule">
            <field name="name">Manufacturing Manager: All Bills</field>
            <field name="model_id" ref="model_manufacturing_bill"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manufacturing_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================ -->
        <!-- PERMISOS DE ACCESO (ACLs) PARA WIZARDS -->
        <!-- ============================================ -->

        <!-- Create Order Wizard - Employee (solo lectura) -->
        <record id="access_create_order_wizard_employee" model="ir.model.access">
            <field name="name">create.order.wizard employee</field>
            <field name="model_id" ref="model_create_order_wizard"/>
            <field name="group_id" ref="group_manufacturing_employee"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Create Order Wizard - Manager (acceso completo) -->
        <record id="access_create_order_wizard_manager" model="ir.model.access">
            <field name="name">create.order.wizard manager</field>
            <field name="model_id" ref="model_create_order_wizard"/>
            <field name="group_id" ref="group_manufacturing_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Create Order Wizard Operation - Employee (solo lectura) -->
        <record id="access_create_order_wizard_operation_employee" model="ir.model.access">
            <field name="name">create.order.wizard.operation employee</field>
            <field name="model_id" ref="model_create_order_wizard_operation"/>
            <field name="group_id" ref="group_manufacturing_employee"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Create Order Wizard Operation - Manager (acceso completo) -->
        <record id="access_create_order_wizard_operation_manager" model="ir.model.access">
            <field name="name">create.order.wizard.operation manager</field>
            <field name="model_id" ref="model_create_order_wizard_operation"/>
            <field name="group_id" ref="group_manufacturing_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
