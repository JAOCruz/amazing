<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_menu_dental_cases" name="Portal layout : Dental Cases menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'dental_cases' or dental_case" t-attf-class="breadcrumb-item #{'active' if not dental_case else ''}">
                <a t-if="dental_case" t-attf-href="/my/dental_cases?{{ keep_query() }}">Casos Dentales</a>
                <t t-else="">Casos Dentales</t>
            </li>
            <li t-if="dental_case" class="breadcrumb-item active">
                <t t-esc="dental_case.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_dental_cases" name="Show Dental Cases" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <style>
                /* Estilos del Home */
                .section-title { font-weight: 600; color: #2c3e50; font-size: 1.5rem; }
                .summary-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
                .stat-card { background: white; border-radius: 10px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-left: 5px solid #00A09D; transition: transform 0.2s, box-shadow 0.2s; cursor: pointer; display: flex; align-items: center; }
                .stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
                .card-icon { font-size: 2.5rem; margin-right: 15px; color: #00A09D; opacity: 0.8; }
                .card-content { flex-grow: 1; text-align: right; }
                .card-value { font-size: 2rem; font-weight: bold; line-height: 1; color: #2c3e50; }
                .card-label { font-size: 0.9rem; color: #7f8c8d; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 5px; }

                /* Estilos de la Lista (Kanban Cards) */
                .kanban-card { display: block; background: white; border: 1px solid #e0e0e0; border-radius: 8px; margin-bottom: 15px; text-decoration: none; color: inherit; transition: all 0.2s; overflow: hidden; }
                .kanban-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); text-decoration: none; color: inherit; }
                .kanban-card.vip-border { border-left: 5px solid #f39c12; }
                .card-header-kanban { padding: 10px 15px; background: #f8f9fa; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; font-weight: bold; }
                .patient-info, .product-info { padding: 8px 15px; font-size: 0.95rem; }
                .card-footer-kanban { padding: 10px 15px; background: white; border-top: 1px solid #eee; display: flex; justify-content: space-between; color: #666; font-size: 0.85rem; }
            </style>

            <div class="o_portal_my_home_dental_cases">
                <!-- Top Profile Section -->
                <div class="row bg-white p-4 rounded shadow-sm mb-4 align-items-center" t-if="user_id.partner_id">
                    <div class="col-md-1">
                        <img t-att-src="image_data_uri(user_id.partner_id.avatar_1024)" alt="Doctor Avatar" class="rounded-circle img-fluid" style="width: 64px; height: 64px; object-fit: cover;"/>
                    </div>
                    <div class="col-md-8">
                        <h4 class="mb-1 text-primary"><t t-esc="user_id.partner_id.name"/></h4>
                        <div class="text-muted"><i class="fa fa-envelope-o mr-2"/> <t t-esc="user_id.partner_id.email"/></div>
                    </div>
                    <div class="col-md-3 text-right">
                         <a href="/my/account" class="btn btn-sm btn-outline-primary"><i class="fa fa-pencil"/> Editar Información</a>
                    </div>
                </div>

                <h2 class="section-title"><i class="fa fa-tooth mr-2"/> Resumen de Mis Casos</h2>
                <div class="summary-cards-grid mt-3 mb-5">
                    <div class="stat-card" onclick="window.location.href='/my/dental_cases'">
                        <div class="card-icon"><i class="fa fa-folder-open"/></div>
                        <div class="card-content">
                            <div class="card-value"><t t-esc="dental_count or 0"/></div>
                            <div class="card-label">Total Activos</div>
                        </div>
                    </div>
                    <div class="stat-card" style="border-left-color: #17a2b8;" onclick="window.location.href='/my/dental_cases?filter_stage=laboratory'">
                        <div class="card-icon" style="color: #17a2b8;"><i class="fa fa-flask"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #17a2b8;"><t t-esc="summary_data['laboratory'] if summary_data else 0"/></div>
                            <div class="card-label">Laboratorio</div>
                        </div>
                    </div>
                    <div class="stat-card" style="border-left-color: #007bff;" onclick="window.location.href='/my/dental_cases?filter_stage=production'">
                        <div class="card-icon" style="color: #007bff;"><i class="fa fa-cogs"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #007bff;"><t t-esc="summary_data['production'] if summary_data else 0"/></div>
                            <div class="card-label">Producción</div>
                        </div>
                    </div>
                    <div class="stat-card" style="border-left-color: #dc3545;" onclick="window.location.href='/my/dental_cases?filter_stage=stopped'">
                        <div class="card-icon" style="color: #dc3545;"><i class="fa fa-pause-circle"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #dc3545;"><t t-esc="summary_data['stopped'] if summary_data else 0"/></div>
                            <div class="card-label">Detenidas</div>
                        </div>
                    </div>
                    <div class="stat-card card-span-4" style="border-left-color: #ffc107;" onclick="window.location.href='/my/dental_cases?filter_stage=testing'">
                        <div class="card-icon" style="color: #ffc107;"><i class="fa fa-check-circle"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #ffc107;"><t t-esc="summary_data['test'] if summary_data else 0"/></div>
                            <div class="card-label">En Prueba</div>
                        </div>
                    </div>
                    <div class="stat-card card-span-4" style="border-left-color: #28a745;" onclick="window.location.href='/my/dental_cases?filter_stage=done'">
                        <div class="card-icon" style="color: #28a745;"><i class="fa fa-check-square"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #28a745;"><t t-esc="summary_data['done'] if summary_data else 0"/></div>
                            <div class="card-label">Finalizadas</div>
                        </div>
                    </div>
                                        <!-- Citas AppBot -->
                    <div class="stat-card card-span-4" style="border-left-color: #00A09D;" onclick="window.location.href='/my/appointments'">
                        <div class="card-icon" style="color: #00A09D;"><i class="fa fa-calendar-check-o"/></div>
                        <div class="card-content">
                            <div class="card-value" style="color: #00A09D;"><t t-esc="appointment_count or 0"/></div>
                            <div class="card-label">Citas Agendadas</div>
                        </div>
                    </div>
                    <!-- VIP Card (Full width for symmetry) -->
                    <div class="stat-card card-span-4" style="border-left-color: #f39c12;" onclick="window.location.href='/my/dental_cases?stage=vip'">
                        <div class="card-icon" style="color: #f39c12;">
                            <i class="fa fa-star"/>
                        </div>
                        <div class="card-content">
                            <div class="card-value" style="color: #f39c12;"><t t-esc="summary_data.get('vip', 0) if summary_data else 0"/></div>
                            <div class="card-label">Soporte VIP</div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        
        <xpath expr="//div[hasclass('o_portal_docs')]" position="attributes">
            <attribute name="t-if">not user_id.has_group('custom_manufacturing_dashboard.group_dental_doctor')</attribute>
        </xpath>


    </template>

    <template id="portal_my_dental_cases" name="My Dental Cases">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Casos Dentales</t>
            </t>

            <div class="row mt-4 mb-4">
                <div class="col-6 col-md-3 mb-3">
                    <a href="/my/dental_cases?filter_stage=laboratory" class="text-decoration-none">
                        <div class="card text-center border-info shadow-sm h-100" style="transition: transform 0.2s;">
                            <div class="card-body">
                                <h3 class="card-title text-info mb-1" t-esc="dashboard_data['lab']"/>
                                <p class="card-text text-muted small font-weight-bold">LABORATORIO</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <a href="/my/dental_cases?filter_stage=production" class="text-decoration-none">
                        <div class="card text-center border-primary shadow-sm h-100" style="transition: transform 0.2s;">
                            <div class="card-body">
                                <h3 class="card-title text-primary mb-1" t-esc="dashboard_data['prod']"/>
                                <p class="card-text text-muted small font-weight-bold">PRODUCCIÓN</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <a href="/my/dental_cases?filter_stage=test" class="text-decoration-none">
                        <div class="card text-center border-warning shadow-sm h-100" style="transition: transform 0.2s;">
                            <div class="card-body">
                                <h3 class="card-title text-warning mb-1" t-esc="dashboard_data['test']"/>
                                <p class="card-text text-muted small font-weight-bold">EN PRUEBA</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <a href="/my/dental_cases?filter_stage=done" class="text-decoration-none">
                        <div class="card text-center border-success shadow-sm h-100" style="transition: transform 0.2s;">
                            <div class="card-body">
                                <h3 class="card-title text-success mb-1" t-esc="dashboard_data['done']"/>
                                <p class="card-text text-muted small font-weight-bold">COMPLETADAS</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <t t-if="not orders">
                <div class="alert alert-info mt-4">
                    <i class="fa fa-info-circle mr-2"/> No se encontraron casos para el filtro seleccionado.
                </div>
            </t>
            
            <t t-if="orders">
                <div class="o_portal_kanban mt-4">
                    <t t-foreach="orders" t-as="case">
                        <a t-attf-href="/my/dental_cases/#{case.id}" t-attf-class="kanban-card #{'vip-border' if case.is_vip else ''}">
                            <div class="card-header-kanban">
                                <span class="case-name"><t t-esc="case.name"/></span>
                                <span t-attf-class="badge #{'badge-warning' if case.is_vip else 'badge-info'}">
                                    <t t-esc="case.stage_custom"/>
                                </span>
                            </div>
                            
                            <div class="patient-info">
                                <i class="fa fa-user-circle"/>
                                <t t-esc="case.patient_name"/>
                            </div>
                            
                            <div class="product-info">
                                <div class="text-truncate" t-att-title="case.product_id.name">
                                    <strong>Producto:</strong> <t t-esc="case.product_id.name"/>
                                </div>
                                <div t-if="case.product_type">
                                    <strong>Tipo:</strong> <span t-field="case.product_type"/>
                                </div>
                            </div>
                            
                            <div class="card-footer-kanban">
                                <div class="deadline-box" t-if="case.date_deadline">
                                    <i class="fa fa-clock-o"/> 
                                    Entrega: <span t-field="case.date_deadline" t-options='{"widget": "date"}'/>
                                </div>
                                <div class="text-muted small" t-if="case.deadline_days >=0">
                                    <t t-esc="case.deadline_days"/> días
                                </div>
                            </div>
                        </a>
                    </t>
                </div>
                
                <div t-if="pager" class="o_portal_pager d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_my_dental_case_page" name="My Dental Case Detail">
        <t t-call="portal.portal_layout">
            <t t-set="dental_case" t-value="order"/>
            
            <div class="container pb-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white p-4">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-12 col-md-auto">
                                <h4 class="mb-0 text-primary">
                                    <i class="fa fa-file-text-o mr-2"/>
                                    Caso <t t-esc="dental_case.name"/>
                                </h4>
                            </div>
                            <div class="col-12 col-md-auto">
                                <span t-field="dental_case.stage_custom" class="badge badge-info p-2" style="font-size: 1rem;"/>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row mb-4">
                            <div class="col-12 col-md-6">
                                <h5 class="border-bottom pb-2 mb-3">Información General</h5>
                                <div class="row mb-2">
                                    <div class="col-4 text-muted">Paciente:</div>
                                    <div class="col-8 fw-bold"><t t-esc="dental_case.patient_name"/></div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-4 text-muted">Doctor:</div>
                                    <div class="col-8"><t t-esc="dental_case.doctor_id.name"/></div>
                                </div>
                                <div class="row mb-2" t-if="dental_case.clinic_id">
                                    <div class="col-4 text-muted">Clínica:</div>
                                    <div class="col-8"><t t-esc="dental_case.clinic_id.name"/></div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <h5 class="border-bottom pb-2 mb-3">Fechas</h5>
                                <div class="row mb-2">
                                    <div class="col-4 text-muted">Fecha Entrega:</div>
                                    <div class="col-8 text-danger fw-bold">
                                        <span t-field="dental_case.date_deadline" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-4 text-muted">Días Restantes:</div>
                                    <div class="col-8"><t t-esc="dental_case.deadline_days"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded mb-4">
                            <h5 class="mb-3">Especificaciones del Producto</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted">Producto:</div>
                                        <div class="col-7"><t t-esc="dental_case.product_id.name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted">Tipo:</div>
                                        <div class="col-7"><span t-field="dental_case.product_type"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted">Material:</div>
                                        <div class="col-7"><span t-field="dental_case.material"/></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted">Color:</div>
                                        <div class="col-7"><span t-field="dental_case.color_selected"/> <span t-field="dental_case.color_scale"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted">Dientes:</div>
                                        <div class="col-7"><t t-esc="dental_case.teeth_numbers"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info" role="alert" t-if="dental_case.doctor_comments">
                            <strong><i class="fa fa-comment-o"/> Comentarios:</strong> <t t-esc="dental_case.doctor_comments"/>
                        </div>

                        <div class="mt-4" t-if="dental_case.workorder_ids">
                            <h5 class="mb-3">Progreso de Fabricación</h5>
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Etapa</th>
                                            <th class="text-center">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="dental_case.workorder_ids" t-as="wo">
                                            <tr>
                                                <td><t t-esc="wo.name"/></td>
                                                <td class="text-center">
                                                    <t t-set="wo_state" t-value="str(wo.state).strip()"/>
                                                    
                                                    <span t-if="wo_state == 'done'" class="badge badge-success" style="color:white; background-color:#28a745;">Listo</span>
                                                    <span t-elif="wo_state == 'progress'" class="badge badge-warning" style="color:white; background-color:#ffc107;">En Proceso</span>
                                                    <span t-elif="wo_state == 'pending'" class="badge badge-secondary" style="color:white; background-color:#6c757d;">Pendiente</span>
                                                    <span t-elif="wo_state == 'ready'" class="badge badge-primary" style="color:white; background-color:#007bff;">Listo para iniciar</span>
                                                    <span t-elif="wo_state == 'waiting'" class="badge badge-info" style="color:white; background-color:#17a2b8;">Esperando</span>
                                                    <span t-elif="wo_state == 'cancel'" class="badge badge-danger" style="color:white; background-color:#dc3545;">Cancelado</span>
                                                    <span t-else="" class="badge badge-light border" style="color:black; background-color:#f8f9fa;">
                                                        <t t-esc="wo.state"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <!-- Citas AppBot: lista -->
    <template id="portal_my_appointments" name="Mis Citas Agendadas">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Citas Agendadas</t>
            </t>
            <div t-if="not appointments" class="alert alert-info mt-3">
                No tienes citas registradas aún.
            </div>
            <t t-if="appointments">
                <div class="card mb-3 mt-3">
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0 o_portal_my_doc_table">
                            <thead class="thead-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Servicio</th>
                                    <th>Cliente / Paciente</th>
                                    <th>WhatsApp</th>
                                    <th>Ubicación</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="appointments" t-as="appt">
                                    <tr>
                                        <td>
                                            <span t-if="appt.date_string" t-field="appt.date_string"/>
                                            <span t-else="" t-field="appt.date"/>
                                        </td>
                                        <td><span t-field="appt.service_name"/></td>
                                        <td><span t-field="appt.client_name"/></td>
                                        <td>
                                            <a t-attf-href="https://wa.me/#{appt.client_number}" target="_blank">
                                                <span t-field="appt.client_number"/>
                                            </a>
                                        </td>
                                        <td>
                                            <a t-if="appt.address and 'maps' in appt.address"
                                               t-att-href="appt.address" target="_blank">Ver mapa</a>
                                            <span t-elif="appt.address" t-field="appt.address"/>
                                            <span t-else="">—</span>
                                        </td>
                                        <td>
                                            <span t-if="appt.state == 'scheduled'" class="badge badge-pill badge-info">Agendada</span>
                                            <span t-elif="appt.state == 'completed'" class="badge badge-pill badge-success">Completada</span>
                                            <span t-else="" class="badge badge-pill badge-danger">Cancelada</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div t-if="pager" class="o_portal_pager text-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

</odoo>