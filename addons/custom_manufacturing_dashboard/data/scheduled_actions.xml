<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- CRON JOB: CHECK DELAYED OPERATIONS -->
        <!-- Runs every 1 minute to check for delayed/urgent workorders -->
        <!-- and automatically post alert messages -->
        <!-- ============================================ -->

        <record id="ir_cron_check_operation_alerts" model="ir.cron">
            <field name="name">Manufacturing: Check Delayed Operations</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="state">code</field>
            <field name="code">model.check_and_send_operation_notifications()</field>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- ============================================ -->
        <!-- CRON JOB: CHECK DELAYED MANUFACTURING ORDERS -->
        <!-- Runs every 5 minutes to check for delayed/urgent production orders -->
        <!-- and automatically post alert messages -->
        <!-- ============================================ -->

        <record id="ir_cron_check_production_alerts" model="ir.cron">
            <field name="name">Manufacturing: Check Delayed Producción Orders</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="state">code</field>
            <field name="code">model.check_and_send_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- ============================================ -->
        <!-- CRON JOB: CHECK FIRST WORKORDER NOT STARTED -->
        <!-- Runs every 1 hour to alert when first workorder has not been started -->
        <!-- ============================================ -->

        <record id="ir_cron_check_first_wo_not_started" model="ir.cron">
            <field name="name">Manufacturing: Check First Workorder Not Started</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="state">code</field>
            <field name="code">model.check_first_workorder_not_started()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- ============================================ -->
        <!-- CRON JOB: CHECK NEXT WORKORDER WAITING -->
        <!-- Runs every 20 minutes to alert when a workorder is waiting after previous completed -->
        <!-- ============================================ -->

        <record id="ir_cron_check_next_wo_waiting" model="ir.cron">
            <field name="name">Manufacturing: Check Next Workorder Waiting</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="state">code</field>
            <field name="code">model.check_next_workorder_waiting()</field>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>
