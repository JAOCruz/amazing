<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ecf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ecf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="e-CF Electronic Invoicing (DGII)"
                       name="l10n_do_ecf_settings">
                    <setting id="l10n_do_ecf_env_setting"
                             string="DGII Environment"
                             help="Select the DGII API environment for e-CF submission.">
                        <field name="l10n_do_ecf_service_env"/>
                    </setting>
                    <setting id="l10n_do_ecf_cert_setting"
                             string="Digital Certificate (P12/PFX)"
                             help="Upload the PKCS#12 certificate issued by the DGII for e-CF signing.">
                        <field name="l10n_do_ecf_certificate"
                               filename="l10n_do_ecf_certificate_filename"/>
                        <field name="l10n_do_ecf_certificate_filename" invisible="1"/>
                    </setting>
                    <setting id="l10n_do_ecf_cert_pass_setting"
                             string="Certificate Password"
                             help="The password for your P12/PFX certificate file.">
                        <field name="l10n_do_ecf_certificate_password" password="True"/>
                    </setting>
                    <setting id="l10n_do_ecf_test_connection"
                             string="Test Connection"
                             help="Test the connection to the DGII e-CF service.">
                        <button name="action_test_dgii_connection"
                                string="Test DGII Connection"
                                type="object"
                                class="btn-primary"
                                icon="fa-plug"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
