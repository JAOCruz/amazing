<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_sales_by_period" model="ir.actions.report">
        <field name="name">Reporte de Ventas por Período</field>
        <field name="model">sales.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_customer_statement.report_sales_by_period</field>
        <field name="report_file">custom_customer_statement.report_sales_by_period</field>
        <field name="print_report_name">'Ventas_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="report_sales_by_period">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="o._get_report_data()"/>
                    <div class="page" style="font-family: Helvetica, Arial, sans-serif; font-size: 11pt; color: #1f2937;">

                        <div style="text-align: center; margin-bottom: 25px;">
                            <h1 style="font-size: 24px; font-weight: 800; color: #2e4159; margin-bottom: 5px;">REPORTE DE VENTAS</h1>
                            <p style="font-size: 12px; color: #6b7280; margin: 0;">
                                Período: <t t-esc="data['date_from'].strftime('%d/%m/%Y')"/> al <t t-esc="data['date_to'].strftime('%d/%m/%Y')"/>
                            </p>
                            <p style="font-size: 11px; color: #6b7280; margin: 2px 0 0;">
                                Agrupado por: <strong><t t-esc="data['group_by_label']"/></strong>
                            </p>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <thead>
                                <tr style="background-color: #2e4159; color: white;">
                                    <th style="padding: 10px; text-align: left; font-size: 10px; text-transform: uppercase;"><t t-esc="data['group_by_label']"/></th>
                                    <th style="padding: 10px; text-align: center; font-size: 10px; text-transform: uppercase;">Cantidad</th>
                                    <th style="padding: 10px; text-align: right; font-size: 10px; text-transform: uppercase;">Monto Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['lines']" t-as="line">
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 10px; font-size: 11px;"><t t-esc="line['name']"/></td>
                                        <td style="padding: 10px; text-align: center; font-size: 11px;"><t t-esc="line['quantity']"/></td>
                                        <td style="padding: 10px; text-align: right; font-size: 11px; font-weight: 600;">
                                            RD$ <t t-esc="'{:,.2f}'.format(line['amount'])"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="border: 1px solid #e5e7eb; border-radius: 6px; padding: 15px; background: #f9fafb;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 11px; color: #6b7280; text-transform: uppercase;">Total General</span>
                                <span style="font-size: 18px; font-weight: 800; color: #2e4159;">
                                    RD$ <t t-esc="'{:,.2f}'.format(data['total'])"/>
                                </span>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
