<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Customer Statement Report Template (Document Body) -->
    <template id="report_customer_statement_document">
        <t t-call="web.external_layout">
            <t t-set="pdata" t-value="doc.partner_id.get_aged_receivable_data(
                move_ids=doc.move_ids.ids if doc.move_ids else None,
                date_from=doc.date_from,
                date_to=doc.date_to
            )"/>
            <t t-set="report_date" t-value="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>

            <div class="page" style="font-family: Helvetica, Arial, sans-serif; color: #1f2937; padding: 10px 15px;">
                <style>
                    .text-brand { color: #2e4159; }
                    .bg-brand { background-color: #2e4159; color: white; }
                    .text-gold { color: #f4a259; }

                    .statement-header {
                        margin-bottom: 20px;
                        padding-bottom: 12px;
                        border-bottom: 3px solid #f4a259;
                    }
                    .statement-title {
                        font-size: 26px;
                        font-weight: 800;
                        color: #2e4159;
                        margin: 0 0 8px 0;
                    }
                    .statement-period {
                        color: #4b5563;
                        font-size: 12px;
                        font-weight: 500;
                    }

                    .custom-card {
                        background: #f9fafb;
                        border: 1px solid #e5e7eb;
                        border-radius: 8px;
                        margin-bottom: 16px;
                        overflow: hidden;
                    }
                    .custom-card-header {
                        background-color: #2e4159;
                        color: white;
                        padding: 10px 14px;
                        font-weight: 700;
                        font-size: 11px;
                        text-transform: uppercase;
                    }
                    .custom-card-body {
                        padding: 16px;
                    }

                    .info-table td {
                        padding: 8px 4px;
                        vertical-align: middle;
                    }
                    .info-label {
                        color: #6b7280;
                        font-weight: 500;
                        width: 25%;
                        font-size: 11px;
                    }
                    .info-value {
                        color: #111827;
                        font-weight: 600;
                        font-size: 12px;
                    }

                    .ar-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 10.5px;
                    }
                    .ar-table th {
                        background-color: #2e4159;
                        color: white;
                        padding: 10px 12px;
                        text-align: right;
                        font-weight: 700;
                        border: 1px solid #2e4159;
                        font-size: 10px;
                    }
                    .ar-table th:first-child { text-align: left; width: 70px; }
                    .ar-table th:nth-child(2) { text-align: left; width: 90px; }
                    .ar-table th:nth-child(3) { text-align: right; width: 75px; }
                    .ar-table th:nth-child(4) { text-align: right; width: 70px; }
                    .ar-table th:nth-child(5) { text-align: right; width: 70px; }
                    .ar-table th:nth-child(6) { text-align: right; width: 70px; }
                    .ar-table th:nth-child(7) { text-align: right; width: 70px; color: #bae6fd; }
                    .ar-table th:nth-child(8) { text-align: right; width: 80px; }
                    .ar-table td {
                        padding: 8px 12px;
                        border: 1px solid #d1d5db;
                        text-align: right;
                        vertical-align: middle;
                    }
                    .ar-table td:first-child { text-align: left; }
                    .ar-table td:nth-child(2) { text-align: left; font-weight: 600; }
                    .ar-table td:nth-child(7) { color: #0369a1; font-weight: 600; }
                    .ar-table tr:nth-child(even) { background-color: #fafafa; }
                    .ar-table tr.overdue-flag { background-color: #fef2f2; }
                    .ar-table tr.highlight { background-color: #fef9c3; }
                    .ar-table tr.paid-flag { background-color: #f0fdf4; }
                    .ar-table td.status-paid { color: #059669; font-weight: 700; }
                    .ar-table td.status-partial { color: #0369a1; font-weight: 600; }

                    .totals-row {
                        font-weight: 700;
                        background-color: #f3f4f6;
                    }
                    .totals-row td {
                        border-top: 2px solid #9ca3af;
                    }
                    .totals-label {
                        text-align: left !important;
                        padding-left: 90px;
                    }

                    .summary-row {
                        margin-bottom: 10px;
                        font-size: 12px;
                        text-align: right;
                    }
                    .summary-label {
                        font-weight: 600;
                        display: inline-block;
                        min-width: 180px;
                        text-align: right;
                        margin-right: 16px;
                        color: #6b7280;
                    }
                    .summary-value {
                        display: inline-block;
                        text-align: right;
                        min-width: 100px;
                        padding-right: 16px;
                        font-weight: 700;
                        color: #2e4159;
                    }
                    .summary-total {
                        border-top: 2px solid #f4a259;
                        padding-top: 10px;
                        margin-top: 10px;
                        font-size: 13px;
                    }
                    .overdue-warning {
                        color: #991b1b;
                        font-weight: 700;
                    }

                    .statement-footer {
                        margin-top: 24px;
                        padding-top: 12px;
                        border-top: 1px solid #d1d5db;
                        font-size: 9px;
                        color: #6b7280;
                        line-height: 1.5;
                    }
                </style>

                <!-- Header Section -->
                <div class="statement-header">
                    <h2 class="statement-title">ESTADO DE CUENTA</h2>
                    <div class="statement-period">
                        <t t-if="doc.date_from">
                            Período: <strong><t t-esc="doc.date_from.strftime('%d/%m/%Y')"/> al <t t-esc="doc.date_to.strftime('%d/%m/%Y') if doc.date_to else 'Hoy'"/></strong>
                        </t>
                        <t t-else="">
                            <strong>Todas las facturas registradas</strong>
                        </t>
                        <span style="margin-left: 20px; color: #6b7280;">Fecha: <t t-esc="report_date"/></span>
                    </div>
                </div>

                <!-- Customer Info Card -->
                <div class="custom-card">
                    <div class="custom-card-header">Información del Cliente</div>
                    <div class="custom-card-body">
                        <table class="info-table" style="width:100%">
                            <tr>
                                <td class="info-label">Cliente:</td>
                                <td class="info-value"><span t-field="doc.partner_id.name"/></td>
                                <td class="info-label">ID:</td>
                                <td class="info-value"><t t-esc="doc.partner_id.id"/></td>
                            </tr>
                            <t t-if="doc.partner_id.vat">
                                <tr>
                                    <td class="info-label">RNC/Cédula:</td>
                                    <td class="info-value"><span t-field="doc.partner_id.vat"/></td>
                                    <td class="info-label">Teléfono:</td>
                                    <td class="info-value"><span t-field="doc.partner_id.phone or doc.partner_id.mobile or ''"/></td>
                                </tr>
                            </t>
                            <t t-if="doc.partner_id.street">
                                <tr>
                                    <td class="info-label">Dirección:</td>
                                    <td class="info-value" colspan="3"><span t-field="doc.partner_id.street"/></td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </div>

                <!-- Aged Receivable Table -->
                <div class="custom-card">
                    <div class="custom-card-header">Detalle por Factura</div>
                    <div class="custom-card-body" style="padding: 0;">
                        <table class="ar-table">
                            <thead>
                                <tr>
                                    <th style="padding-left: 12px;">Fecha</th>
                                    <th style="padding-left: 12px;">Factura</th>
                                    <th style="padding-right: 12px;">Facturado</th>
                                    <th style="padding-right: 12px;">0-30</th>
                                    <th style="padding-right: 12px;">31-60</th>
                                    <th style="padding-right: 12px;">61-90</th>
                                    <th style="padding-right: 12px;">+90</th>
                                    <th style="padding-right: 12px;">Abono</th>
                                    <th style="padding-right: 12px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="pdata['lines']" t-as="line">
                                    <tr t-att-class="'paid-flag' if line['residual'] &lt;= 0 else 'overdue-flag' if line['days'] &gt; 30 else 'highlight' if line['days'] &lt;= 7 else ''">
                                        <td style="padding-left: 12px;"><t t-esc="line['date'].strftime('%d/%m/%Y')"/></td>
                                        <td style="padding-left: 12px;"><t t-esc="line['document']"/></td>
                                        <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(line['amount_total'])"/></td>
                                        <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(line['0_30'])"/></td>
                                        <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(line['31_60'])"/></td>
                                        <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(line['61_90'])"/></td>
                                        <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(line['90_plus'])"/></td>
                                        <td style="padding-right: 12px;">
                                            <t t-if="line['payments'] &gt; 0">
                                                <t t-esc="'{:,.2f}'.format(line['payments'])"/>
                                                <t t-if="line['residual'] &lt;= 0"> <span class="status-paid">(Pagada)</span></t>
                                                <t t-elif="line['payments'] &lt; line['amount_total']"> <span class="status-partial">(Parcial)</span></t>
                                            </t>
                                            <t t-else="">0.00</t>
                                        </td>
                                        <td style="padding-right: 12px;">
                                            <t t-if="line['residual'] &lt;= 0"><span class="status-paid">Pagada</span></t>
                                            <t t-else=""><t t-esc="'{:,.2f}'.format(line['residual'])"/></t>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="totals-row">
                                    <td colspan="2" class="totals-label">TOTAL:</td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(sum(l['amount_total'] for l in pdata['lines']))"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['0_30'])"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['31_60'])"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['61_90'])"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['90_plus'])"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['payments'])"/></td>
                                    <td style="padding-right: 12px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['total'])"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Summary -->
                <div class="custom-card">
                    <div class="custom-card-header">Resumen</div>
                    <div class="custom-card-body">
                        <div class="summary-row">
                            <span class="summary-label">Total Facturado:</span>
                            <span class="summary-value">RD$ <t t-esc="'{:,.2f}'.format(sum(l['amount_total'] for l in pdata['lines']))"/></span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">Total Abonos:</span>
                            <span class="summary-value">RD$ <t t-esc="'{:,.2f}'.format(pdata['totals']['payments'])"/></span>
                        </div>
                        <div class="summary-row summary-total">
                            <span class="summary-label">Saldo Pendiente:</span>
                            <span class="summary-value" t-att-class="'overdue-warning' if pdata['totals']['total'] &gt; 0 else ''" style="padding-right: 16px;">
                                RD$ <t t-esc="'{:,.2f}'.format(pdata['totals']['total'])"/>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Legend -->
                <div style="margin-top: 16px; padding: 10px; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 10px;">
                    <strong>Leyenda:</strong>
                    <span style="background-color: #fef2f2; padding: 2px 6px; border-radius: 3px; margin-left: 10px;">
                        <span class="overdue-warning">■</span> Vencida
                    </span>
                    <span style="background-color: #fef9c3; padding: 2px 6px; border-radius: 3px; margin-left: 10px;">
                        <span style="color: #a16207;">■</span> ≤ 7 días
                    </span>
                    <span style="background-color: #f0fdf4; padding: 2px 6px; border-radius: 3px; margin-left: 10px;">
                        <span style="color: #059669;">■</span> Pagada
                    </span>
                </div>

                <!-- Footer -->
                <div class="statement-footer">
                    <p><strong>Importante:</strong> Este estado de cuenta fue generado automáticamente por el sistema de facturación de Amazing Prosthetics.</p>
                    <p>Si tiene preguntas sobre esta cuenta, por favor contacte al departamento de facturación.</p>
                    <p><strong>Fecha de Generación:</strong> <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/></p>
                </div>
            </div>
        </t>
    </template>

    <!-- Customer Statement Report Container Template -->
    <template id="report_customer_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="custom_customer_statement.report_customer_statement_document"/>
            </t>
        </t>
    </template>

    <!-- Aged Receivable Consolidated Report Template -->
    <template id="report_customer_statement_consolidated_document">
        <t t-call="web.external_layout">
            <t t-set="report_date" t-value="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
            <t t-set="grand_totals" t-value="{'payments': 0.0, '0_30': 0.0, '31_60': 0.0, '61_90': 0.0, '90_plus': 0.0, 'total': 0.0}"/>

            <div class="page" style="font-family: Helvetica, Arial, sans-serif; color: #1f2937; padding: 10px 15px;">
                <style>
                    .ar-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; border-bottom: 2px solid #2e4159; padding-bottom: 10px; }
                    .ar-header-left { font-size: 11px; color: #6b7280; }
                    .ar-header-center { text-align: center; }
                    .ar-header-center h1 { margin: 0; font-size: 20px; color: #2e4159; }
                    .ar-header-right { font-size: 11px; font-weight: 700; color: #2e4159; text-align: right; }

                    .client-block { margin-bottom: 16px; page-break-inside: avoid; }
                    .client-header { background-color: #f3f4f6; padding: 6px 10px; font-weight: 700; font-size: 10px; color: #2e4159; border: 1px solid #d1d5db; border-bottom: none; }
                    .client-header span { margin-right: 12px; }
                    .client-phone { font-weight: 500; color: #6b7280; }

                    .ar-table { width: 100%; border-collapse: collapse; font-size: 9.5px; }
                    .ar-table th { background-color: #2e4159; color: white; padding: 8px 10px; text-align: right; font-weight: 700; border: 1px solid #2e4159; }
                    .ar-table th:first-child { text-align: left; width: 65px; }
                    .ar-table th:nth-child(2) { text-align: left; width: 85px; }
                    .ar-table th:nth-child(3) { text-align: right; width: 70px; }
                    .ar-table th:nth-child(4) { text-align: right; width: 75px; color: #bae6fd; }
                    .ar-table td { padding: 6px 10px; border: 1px solid #d1d5db; text-align: right; vertical-align: middle; }
                    .ar-table td:first-child { text-align: left; }
                    .ar-table td:nth-child(2) { text-align: left; font-weight: 600; }
                    .ar-table td:nth-child(4) { color: #0369a1; font-weight: 600; }
                    .ar-table tr:nth-child(even) { background-color: #fafafa; }
                    .ar-table tr.overdue-flag { background-color: #fef2f2; }
                    .ar-table tr.highlight { background-color: #fef9c3; }
                    .ar-table tr.paid-flag { background-color: #f0fdf4; }
                    .ar-table td.status-paid { color: #059669; font-weight: 700; }
                    .ar-table td.status-partial { color: #0369a1; font-weight: 600; }

                    .subtotal-row { font-weight: 700; background-color: #f3f4f6; }
                    .subtotal-row td { border-top: 2px solid #9ca3af; }
                    .subtotal-label { text-align: left !important; padding-left: 90px; }

                    .grand-total { margin-top: 18px; border-top: 3px solid #2e4159; padding-top: 10px; font-size: 12px; font-weight: 700; text-align: right; padding-right: 16px; }
                </style>

                <div class="ar-header">
                    <div class="ar-header-left"><t t-esc="report_date"/></div>
                    <div class="ar-header-center"><h1>Factura</h1></div>
                    <div class="ar-header-right">Valores en $RD</div>
                </div>

                <t t-foreach="doc.partner_ids" t-as="partner">
                    <t t-set="pdata" t-value="partner.get_aged_receivable_data(date_from=doc.date_from, date_to=doc.date_to)"/>
                    <t t-if="pdata['lines']">
                        <div class="client-block">
                            <div class="client-header">
                                <span>Cliente <t t-esc="pdata['partner_id']"/></span>
                                <span><t t-esc="pdata['partner_name']"/></span>
                                <span class="client-phone" t-if="pdata['partner_phone']">Teléfono <t t-esc="pdata['partner_phone']"/></span>
                            </div>
                            <table class="ar-table">
                                <thead>
                                    <tr>
                                        <th style="padding-left: 10px;">Fecha</th>
                                        <th style="padding-left: 10px;">Factura</th>
                                        <th style="padding-right: 10px;">Facturado</th>
                                        <th style="padding-right: 10px;">Abono</th>
                                        <th style="padding-right: 10px;">0 - 30</th>
                                        <th style="padding-right: 10px;">31 - 60</th>
                                        <th style="padding-right: 10px;">61 - 90</th>
                                        <th style="padding-right: 10px;">+90</th>
                                        <th style="padding-right: 10px;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="pdata['lines']" t-as="line">
                                        <tr t-att-class="'paid-flag' if line['residual'] &lt;= 0 else 'overdue-flag' if line['days'] &gt; 30 else 'highlight' if line['days'] &lt;= 7 else ''">
                                            <td style="padding-left: 10px;"><t t-esc="line['date'].strftime('%d/%m/%Y')"/></td>
                                            <td style="padding-left: 10px;"><t t-esc="line['document']"/></td>
                                            <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(line['amount_total'])"/></td>
                                            <td style="padding-right: 10px;">
                                                <t t-if="line['payments'] &gt; 0">
                                                    <t t-esc="'{:,.2f}'.format(line['payments'])"/>
                                                    <t t-if="line['residual'] &lt;= 0"> <span class="status-paid">(Pagada)</span></t>
                                                    <t t-elif="line['payments'] &lt; line['amount_total']"> <span class="status-partial">(Parcial)</span></t>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>
                                            <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(line['0_30'])"/></td>
                                            <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(line['31_60'])"/></td>
                                            <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(line['61_90'])"/></td>
                                            <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(line['90_plus'])"/></td>
                                            <td style="padding-right: 10px;">
                                                <t t-if="line['residual'] &lt;= 0"><span class="status-paid">Pagada</span></t>
                                                <t t-else=""><t t-esc="'{:,.2f}'.format(line['residual'])"/></t>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="subtotal-row">
                                        <td colspan="2" class="subtotal-label">Total :</td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(sum(l['amount_total'] for l in pdata['lines']))"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['payments'])"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['0_30'])"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['31_60'])"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['61_90'])"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['90_plus'])"/></td>
                                        <td style="padding-right: 10px;"><t t-esc="'{:,.2f}'.format(pdata['totals']['total'])"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Accumulate grand totals -->
                        <t t-set="_" t-value="grand_totals.update({
                            'payments': grand_totals['payments'] + pdata['totals']['payments'],
                            '0_30': grand_totals['0_30'] + pdata['totals']['0_30'],
                            '31_60': grand_totals['31_60'] + pdata['totals']['31_60'],
                            '61_90': grand_totals['61_90'] + pdata['totals']['61_90'],
                            '90_plus': grand_totals['90_plus'] + pdata['totals']['90_plus'],
                            'total': grand_totals['total'] + pdata['totals']['total'],
                        })"/>
                    </t>
                </t>

                <div class="grand-total">
                    TOTAL GENERAL:  
                    <t t-if="grand_totals['payments'] &gt; 0">Abonos <t t-esc="'{:,.2f}'.format(grand_totals['payments'])"/> | </t>
                    0-30: <t t-esc="'{:,.2f}'.format(grand_totals['0_30'])"/> |
                    31-60: <t t-esc="'{:,.2f}'.format(grand_totals['31_60'])"/> |
                    61-90: <t t-esc="'{:,.2f}'.format(grand_totals['61_90'])"/> |
                    +90: <t t-esc="'{:,.2f}'.format(grand_totals['90_plus'])"/> |
                    <strong>Total: <t t-esc="'{:,.2f}'.format(grand_totals['total'])"/></strong>
                </div>
            </div>
        </t>
    </template>

    <template id="report_customer_statement_consolidated">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="custom_customer_statement.report_customer_statement_consolidated_document"/>
            </t>
        </t>
    </template>

    <!-- IR Actions Report: Individual -->
    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Estado de Cuenta del Cliente</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_customer_statement.report_customer_statement</field>
        <field name="print_report_name">'Estado_de_Cuenta_%s' % object.partner_id.name.replace(' ', '_')</field>
    </record>

    <!-- IR Actions Report: Consolidated -->
    <record id="action_report_customer_statement_consolidated" model="ir.actions.report">
        <field name="name">Estado de Cuenta Consolidado</field>
        <field name="model">customer.statement.batch.wizard</field>
